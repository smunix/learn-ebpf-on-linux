direction: right

classes: {
  kernel: {
    style: {
      fill: "#0B1F33"
      font-color: "#FFFFFF"
      stroke: "#0B1F33"
      border-radius: 8
    }
  }
  user: {
    style: {
      fill: "#EAF3FB"
      font-color: "#0B1F33"
      stroke: "#1769AA"
      border-radius: 8
    }
  }
  data: {
    style: {
      fill: "#E7F6F5"
      font-color: "#0B1F33"
      stroke: "#007F8B"
      border-radius: 8
    }
  }
  decision: {
    shape: diamond
    style: {
      fill: "#FFF4DF"
      font-color: "#5C3500"
      stroke: "#B45309"
      border-radius: 8
    }
  }
  risk: {
    style: {
      fill: "#FCEBEC"
      font-color: "#6D1E1E"
      stroke: "#9D2A2A"
      border-radius: 8
    }
  }
  note: {
    shape: document
    style: {
      fill: "#F6F9FA"
      font-color: "#162433"
      stroke: "#526577"
      border-radius: 6
    }
  }
}

n_access: "CPU memory access\nmissing translation" {class: kernel}
n_fault: "Page-fault handler\naddress + flags" {class: kernel}
n_vma: "VMA lookup\npermissions + mapping" {class: data}
n_present: "Resident page?" {class: decision}
n_alloc: "Allocate / reclaim\npage frame" {class: kernel}
n_io: "File-backed I/O\nor zero-fill" {class: kernel}
n_map: "Install PTE\nresume instruction" {class: data}
n_observe: "eBPF aggregation\ncounts, not causality" {class: note}
n_access -> n_fault
n_fault -> n_vma
n_vma -> n_present
n_present -> n_map: "yes"
n_present -> n_alloc: "no"
n_alloc -> n_io
n_io -> n_map
n_fault -> n_observe: "tracepoint fields"
