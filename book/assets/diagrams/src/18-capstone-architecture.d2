direction: right

classes: {
  kernel: {
    style: {
      fill: "#0B1F33"
      font-color: "#FFFFFF"
      stroke: "#0B1F33"
      border-radius: 8
    }
  }
  user: {
    style: {
      fill: "#EAF3FB"
      font-color: "#0B1F33"
      stroke: "#1769AA"
      border-radius: 8
    }
  }
  data: {
    style: {
      fill: "#E7F6F5"
      font-color: "#0B1F33"
      stroke: "#007F8B"
      border-radius: 8
    }
  }
  decision: {
    shape: diamond
    style: {
      fill: "#FFF4DF"
      font-color: "#5C3500"
      stroke: "#B45309"
      border-radius: 8
    }
  }
  risk: {
    style: {
      fill: "#FCEBEC"
      font-color: "#6D1E1E"
      stroke: "#9D2A2A"
      border-radius: 8
    }
  }
  note: {
    shape: document
    style: {
      fill: "#F6F9FA"
      font-color: "#162433"
      stroke: "#526577"
      border-radius: 6
    }
  }
}

n_cli: "Sentinel CLI\nmode + protected file" {class: user}
n_resolver: "Userspace resolver\npath → device,inode" {class: user}
n_control: "Policy control plane\ncgroup scope + map updates" {class: user}
n_policy: "Policy maps\nidentity + mode" {class: data}
n_lsm: "BPF LSM\nfile-open hook" {class: kernel}
n_ring: "Ring buffer\naudit rationale" {class: data}
n_agent: "Event consumer\nloss accounting" {class: user}
n_ops: "Operator\nreview / rollback" {class: user}
n_cli -> n_resolver
n_resolver -> n_control
n_control -> n_policy
n_policy -> n_lsm: "lookup"
n_lsm -> n_ring: "event"
n_ring -> n_agent
n_agent -> n_ops
n_ops -> n_control: "audit → enforce\nor detach"
