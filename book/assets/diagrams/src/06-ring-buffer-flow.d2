direction: right

classes: {
  kernel: {
    style: {
      fill: "#0B1F33"
      font-color: "#FFFFFF"
      stroke: "#0B1F33"
      border-radius: 8
    }
  }
  user: {
    style: {
      fill: "#EAF3FB"
      font-color: "#0B1F33"
      stroke: "#1769AA"
      border-radius: 8
    }
  }
  data: {
    style: {
      fill: "#E7F6F5"
      font-color: "#0B1F33"
      stroke: "#007F8B"
      border-radius: 8
    }
  }
  decision: {
    shape: diamond
    style: {
      fill: "#FFF4DF"
      font-color: "#5C3500"
      stroke: "#B45309"
      border-radius: 8
    }
  }
  risk: {
    style: {
      fill: "#FCEBEC"
      font-color: "#6D1E1E"
      stroke: "#9D2A2A"
      border-radius: 8
    }
  }
  note: {
    shape: document
    style: {
      fill: "#F6F9FA"
      font-color: "#162433"
      stroke: "#526577"
      border-radius: 6
    }
  }
}

n_hook: "Process-exec hook" {class: kernel}
n_reserve: "Reserve record\nfixed event ABI" {class: data}
n_ring: "Shared ring buffer\nordered records" {class: data}
n_consumer: "Userspace consumer\nparse + enrich" {class: user}
n_metrics: "lost_events counter\nbackpressure signal" {class: risk}
n_storage: "Log / policy engine" {class: user}
n_hook -> n_reserve: "event"
n_reserve -> n_ring: "submit"
n_reserve -> n_metrics: "reserve fails"
n_ring -> n_consumer: "poll"
n_consumer -> n_storage: "structured event"
n_consumer -> n_metrics: "report loss"
