direction: right

classes: {
  kernel: {
    style: {
      fill: "#0B1F33"
      font-color: "#FFFFFF"
      stroke: "#0B1F33"
      border-radius: 8
    }
  }
  user: {
    style: {
      fill: "#EAF3FB"
      font-color: "#0B1F33"
      stroke: "#1769AA"
      border-radius: 8
    }
  }
  data: {
    style: {
      fill: "#E7F6F5"
      font-color: "#0B1F33"
      stroke: "#007F8B"
      border-radius: 8
    }
  }
  decision: {
    shape: diamond
    style: {
      fill: "#FFF4DF"
      font-color: "#5C3500"
      stroke: "#B45309"
      border-radius: 8
    }
  }
  risk: {
    style: {
      fill: "#FCEBEC"
      font-color: "#6D1E1E"
      stroke: "#9D2A2A"
      border-radius: 8
    }
  }
  note: {
    shape: document
    style: {
      fill: "#F6F9FA"
      font-color: "#162433"
      stroke: "#526577"
      border-radius: 6
    }
  }
}

n_wakeup: "t0 wakeup\ntracepoint" {class: data}
n_rq: "Run queue\nper-CPU state" {class: kernel}
n_preempt: "Runnable but waiting\npriority / preemption" {class: risk}
n_switch: "t1 sched_switch\nnext task runs" {class: data}
n_latency: "Δ = t1 − t0\naggregate histogram" {class: user}
n_cleanup: "delete task key\non switch / exit" {class: note}
n_wakeup -> n_rq: "enqueue"
n_rq -> n_preempt: "not selected"
n_preempt -> n_switch: "selected"
n_rq -> n_switch: "immediate selection"
n_switch -> n_latency: "lookup t0"
n_latency -> n_cleanup
